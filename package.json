{
	"name": "magari",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm build && wrangler dev",
		"deploy": "pnpm build && wrangler deploy",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply magari --local",
		"db:migrate:remote": "wrangler d1 migrations apply magari --remote"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.157.0"
	},
	"dependencies": {
		"@better-auth/passkey": "^1.7.16",
		"better-auth": "^1.7.16",
		"rrule": "^2.8.1"
	}
}
