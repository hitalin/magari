{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "magari",
	"main": "worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	// 本番ドメイン。Workers のカスタムドメインとして割り当てる（DNS も自動）
	"routes": [{ "pattern": "magari.cc", "custom_domain": true }],
	// 外部カレンダーの取り込み（vars の IMPORT_ENABLED=1 とセット）。毎時 15 分に worker.ts の scheduled が走る。
	// 止めるときは、この triggers を "crons": [] にし、IMPORT_ENABLED を消す
	"triggers": { "crons": ["15 * * * *"] },
	// 読み取りが東京 PoP に近くなるよう primary は apac に置く（wrangler d1 create --location apac）
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "magari",
			"database_id": "367b5814-180f-4608-8412-c7fe6f3af213",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "magari-media" }],
	// X で共有したときのカード画像を撮る（/e/{id}/og.png）。無料枠はブラウザ時間が 1 日 10 分
	"browser": { "binding": "BROWSER" },
	// 落書き（POST /api/graffiti）は誰でも送れるので、同じ IP からは 1 分に 20 回まで。IP は保存しない
	"ratelimits": [
		{
			"name": "GRAFFITI_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"vars": {
		"PUBLIC_ORIGIN": "https://magari.cc",
		// 外部カレンダーの取り込みを動かす。見本用の IMPORT_SAMPLES は本番に置かない（店の写真は写すが、X のアイコンと紹介文は写さない）
		"IMPORT_ENABLED": "1",
		// 運営者の handle。/admin/reports（連絡の受信箱と掲載拒否リスト）を見られる
		"ADMIN_HANDLE": "hitalin"
	}
}
